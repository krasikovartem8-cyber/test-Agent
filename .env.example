# ── Провайдер модели ────────────────────────────────────────────────────────
# anthropic | openai | auto (auto = по наличию ключа, Anthropic приоритетнее)
LLM_PROVIDER=auto

# Вариант 1: Anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
SUBAGENT_MODEL=claude-sonnet-5

# Вариант 2: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_SUBAGENT_MODEL=gpt-5.4-mini

# Вариант 3: любой OpenAI-совместимый шлюз (есть бесплатные тарифы).
# Задайте LLM_PROVIDER=openai, OPENAI_API_KEY от выбранного сервиса и:
#   Groq         OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                OPENAI_MODEL=deepseek/deepseek-chat
#   Google       OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                OPENAI_MODEL=gemini-2.5-flash
#   Ollama       OPENAI_BASE_URL=http://localhost:11434/v1
#                OPENAI_MODEL=qwen3:8b   (ключ можно любой)
# Модель обязана поддерживать вызов инструментов (function calling).
OPENAI_BASE_URL=

# 0 — модель не умеет читать картинки: скриншоты не отправляются
VISION=1

# ── Агент ───────────────────────────────────────────────────────────────────
# Глубина рассуждений: low | medium | high | xhigh | max
AGENT_EFFORT=high
# Максимум шагов за одну задачу до запроса подтверждения
MAX_STEPS=80
# Порог контекста (токенов), после которого история сжимается
CONTEXT_TOKEN_LIMIT=150000

# ── Браузер ─────────────────────────────────────────────────────────────────
# chrome (установленный Google Chrome) или chromium (скачанный Playwright)
BROWSER_CHANNEL=chrome
# Каталог профиля браузера (сохраняет логины/куки между запусками)
USER_DATA_DIR=.browser-profile
# Запись видео браузера в ./recordings (1 = включить)
RECORD_VIDEO=0
# 1 — показывать результаты инструментов целиком
VERBOSE=0
